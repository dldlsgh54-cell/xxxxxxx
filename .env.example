# Meta Threads 사용자 토큰. threads_basic, threads_read_replies 권한 필요
THREADS_ACCESS_TOKEN=
# 단기 토큰을 입력할 때 Threads 앱 시크릿도 입력하면 장기 토큰으로 교환합니다.
THREADS_APP_SECRET=

# X 개발자 콘솔의 OAuth 2.0 Client ID. Native App이면 Secret은 비워 둡니다.
X_CLIENT_ID=
X_CLIENT_SECRET=

# 새 글 확인 주기(초), 쿠팡 댓글 확인 주기(초), X 게시 주기(초, 0이면 즉시)
POLL_SECONDS=60
REPLY_POLL_SECONDS=300
X_PUBLISH_SECONDS=0
# 늦게 달린 쿠팡 댓글을 확인하는 기간(일)
REPLY_LOOKBACK_DAYS=7
# 비어 있으면 최초 실제 실행 시점 이후의 글부터 발행합니다.
# 예: 2026-11-23T09:00:00+09:00
SYNC_FROM=
